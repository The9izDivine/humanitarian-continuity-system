{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the9izdivine.github.io/humanitarian-continuity-system/schemas/needs_assessment.schema.json",
  "title": "Needs Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "incident_id",
    "household_id",
    "assessed_at",
    "needs",
    "data_classification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^NA-[0-9]{6}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^INC-[0-9]{6}$"
    },
    "household_id": {
      "type": "string",
      "pattern": "^HH-[0-9]{6}$"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "need_id",
          "category",
          "state",
          "verification_status"
        ],
        "properties": {
          "need_id": {
            "type": "string",
            "pattern": "^NEED-[0-9]{6}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "SAFE_SHELTER",
              "FOOD_AND_WATER",
              "CLOTHING",
              "HYGIENE",
              "MEDICATION_SUPPORT",
              "ACCESSIBILITY_SUPPORT",
              "TRANSLATION",
              "TRANSPORTATION",
              "MENTAL_HEALTH_SUPPORT",
              "FAMILY_REUNIFICATION",
              "PET_ACCOMMODATION",
              "RECOVERY_REFERRAL",
              "OTHER"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "UNASSESSED",
              "REPORTED",
              "OBSERVED",
              "VERIFIED",
              "AUTHORIZED",
              "ASSIGNED",
              "IN_PROGRESS",
              "FULFILLED",
              "PARTIALLY_FULFILLED",
              "UNABLE_TO_FULFILL",
              "REFERRED",
              "UNKNOWN"
            ]
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "PARTIALLY_VERIFIED",
              "VERIFIED",
              "UNKNOWN"
            ]
          },
          "unresolved_description": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "PUBLIC_SYNTHETIC",
        "INTERNAL_SYNTHETIC"
      ]
    }
  }
}